# BizSahayak Government Open Data & API Setu Portal Credentials
# Copy this file to .env and set your official API keys

# 1. API Setu myScheme Portal API Credentials (https://directory.apisetu.gov.in)
API_SETU_MYSCHEME_API_KEY=your_apisetu_myscheme_api_key
API_SETU_MYSCHEME_CLIENT_ID=your_apisetu_client_id

# 2. Open Government Data Platform API Key (https://data.gov.in)
GOV_DATA_API_KEY=your_gov_data_api_key
